<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
    stylesheets="@/styles/sante.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.sante.lims.controller.CustomerDashboardController">
  <children>
    <HBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

      <!-- Sidebar -->
      <VBox styleClass="sidebar" spacing="4">
        <Label text="Sante Diagnostics" styleClass="sidebar-title"/>
        <Label text="Patient Portal"     styleClass="sidebar-subtitle"/>
        <Button fx:id="navBrowse"   text="🔍  Browse Tests" onAction="#onNavBrowse"   styleClass="nav-btn"/>
        <Button fx:id="navMyOrders" text="📋  My Orders"    onAction="#onNavMyOrders" styleClass="nav-btn"/>
        <Button fx:id="navResults"  text="📄  My Results"   onAction="#onNavResults"  styleClass="nav-btn"/>
        <VBox VBox.vgrow="ALWAYS"/>
        <Button text="⏻  Logout" onAction="#onLogout" styleClass="logout-btn"/>
      </VBox>

      <!-- Main -->
      <VBox HBox.hgrow="ALWAYS">
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
          <Label fx:id="pageTitleLabel" text="Browse Tests" styleClass="page-title"/>
          <HBox HBox.hgrow="ALWAYS"/>
          <Label fx:id="welcomeLabel" style="-fx-text-fill:#888; -fx-font-size:13px;"/>
        </HBox>

        <StackPane VBox.vgrow="ALWAYS" styleClass="content-area">

          <!-- BROWSE TESTS -->
          <VBox fx:id="paneBrowse" spacing="16" visible="true" managed="true">
            <Label text="Available Tests" styleClass="card-title"/>
            <TableView fx:id="testsTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colBName"     text="Test Name" prefWidth="200"/>
                <TableColumn fx:id="colBCategory" text="Category"  prefWidth="130"/>
                <TableColumn fx:id="colBPrice"    text="Price (₦)" prefWidth="110"/>
                <TableColumn fx:id="colBTat"      text="TAT (hrs)" prefWidth="100"/>
                <TableColumn fx:id="colBFormat"   text="Format"    prefWidth="100"/>
                <TableColumn fx:id="colBOrder"    text="Order"     prefWidth="100"/>
              </columns>
            </TableView>
            <VBox fx:id="bankDetailsBox" styleClass="card" spacing="8"
                  visible="false" managed="false">
              <Label text="Order Placed! Please make payment to:" styleClass="card-title"/>
              <Label fx:id="bankNameLabel"    style="-fx-font-size:13px;"/>
              <Label fx:id="bankAccNameLabel" style="-fx-font-size:13px;"/>
              <Label fx:id="bankAccNumLabel"  style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#e91e8c;"/>
              <Label text="After payment, inform the lab attendant with your order reference."
                     style="-fx-text-fill:#888; -fx-font-size:12px;" wrapText="true"/>
              <Button text="Done" onAction="#onBankDetailsDone" styleClass="btn-secondary"/>
            </VBox>
          </VBox>

          <!-- MY ORDERS -->
          <VBox fx:id="paneMyOrders" spacing="16" visible="false" managed="false">
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Label text="My Orders" styleClass="card-title"/>
              <HBox HBox.hgrow="ALWAYS"/>
              <Button text="↻ Refresh" onAction="#onRefreshOrders" styleClass="btn-secondary"/>
            </HBox>
            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colOTest"      text="Test"           prefWidth="200"/>
                <TableColumn fx:id="colOStatus"    text="Status"         prefWidth="140"/>
                <TableColumn fx:id="colOPayment"   text="Payment"        prefWidth="100"/>
                <TableColumn fx:id="colODate"      text="Ordered"        prefWidth="140"/>
                <TableColumn fx:id="colOCountdown" text="Time Remaining" prefWidth="160"/>
              </columns>
            </TableView>
          </VBox>

          <!-- MY RESULTS -->
          <VBox fx:id="paneResults" spacing="16" visible="false" managed="false">
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Label text="My Results" styleClass="card-title"/>
              <HBox HBox.hgrow="ALWAYS"/>
              <Button text="↻ Refresh" onAction="#onRefreshResults" styleClass="btn-secondary"/>
            </HBox>
            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colRTest"   text="Test"      prefWidth="200"/>
                <TableColumn fx:id="colRFormat" text="Format"    prefWidth="100"/>
                <TableColumn fx:id="colRDate"   text="Validated" prefWidth="140"/>
                <TableColumn fx:id="colRView"   text="View"      prefWidth="100"/>
                <TableColumn fx:id="colRDown"   text="Download"  prefWidth="100"/>
              </columns>
            </TableView>
            <VBox fx:id="resultViewBox" styleClass="card" spacing="8"
                  visible="false" managed="false">
              <Label fx:id="resultViewTitle" styleClass="card-title"/>
              <TextArea fx:id="resultViewText" prefHeight="120" wrapText="true" editable="false"/>
            </VBox>
          </VBox>

        </StackPane>
      </VBox>
    </HBox>
  </children>
</AnchorPane>
