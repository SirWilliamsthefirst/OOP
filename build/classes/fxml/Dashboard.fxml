<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sante.lims.controller.DashboardController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="16.0" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_RIGHT" spacing="10.0" AnchorPane.rightAnchor="0.0">
                <Button text="Logout" onAction="#onLogout" />
            </HBox>
            <Label fx:id="welcomeLabel" text="Welcome" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            <Label fx:id="roleLabel" text="Role" />
            <Label fx:id="statusLabel" wrapText="true" text="This is a placeholder dashboard. Your authenticated role determines the next workflow." />
        </VBox>
    </children>
</AnchorPane>
