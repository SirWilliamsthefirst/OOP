<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
    stylesheets="@/styles/sante.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.sante.lims.controller.ChangePasswordController">
  <children>
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
               style="-fx-background-color: linear-gradient(to bottom right, #fce4ec, #f8bbd0);">
      <VBox alignment="CENTER" spacing="14" styleClass="auth-panel">
        <Label text="Set New Password" styleClass="auth-title"/>
        <Label text="Your account requires a password change before continuing."
               styleClass="auth-subtitle" wrapText="true" maxWidth="340"/>

        <VBox spacing="6">
          <Label text="New Password" styleClass="form-label"/>
          <PasswordField fx:id="newPasswordField" promptText="Minimum 8 characters" prefWidth="340"/>
        </VBox>
        <VBox spacing="6">
          <Label text="Confirm Password" styleClass="form-label"/>
          <PasswordField fx:id="confirmPasswordField" promptText="Repeat password" prefWidth="340"/>
        </VBox>

        <Button text="Save Password" onAction="#onSave"   styleClass="btn-primary"
                prefWidth="340" style="-fx-padding: 10 0;"/>
        <Button text="Cancel"        onAction="#onCancel" styleClass="btn-secondary"
                prefWidth="340"/>

        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" maxWidth="340"/>
      </VBox>
    </StackPane>
  </children>
</AnchorPane>
