<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane"
    stylesheets="@/styles/sante.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.sante.lims.controller.VerifyEmailController">
  <children>
    <StackPane AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
               AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
               style="-fx-background-color: linear-gradient(to bottom right, #fce4ec, #f8bbd0);">
      <VBox alignment="CENTER" spacing="14" styleClass="auth-panel">
        <Label text="Verify Your Email" styleClass="auth-title"/>
        <Label text="Enter the token sent to your email address."
               styleClass="auth-subtitle" wrapText="true"/>

        <VBox spacing="6">
          <Label text="Email" styleClass="form-label"/>
          <TextField fx:id="emailField" promptText="name@example.com" prefWidth="340"/>
        </VBox>
        <VBox spacing="6">
          <Label text="Verification Token" styleClass="form-label"/>
          <TextField fx:id="tokenField" promptText="Paste token here" prefWidth="340"/>
        </VBox>

        <Button text="Verify"           onAction="#onVerify" styleClass="btn-primary"
                prefWidth="340" style="-fx-padding: 10 0;"/>
        <Button text="← Back to Login"  onAction="#onBack"   styleClass="btn-secondary"
                prefWidth="340"/>

        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true" maxWidth="340"/>
      </VBox>
    </StackPane>
  </children>
</AnchorPane>
